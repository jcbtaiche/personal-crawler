---
import { loadPublishedItems, sections, displayDate } from "../lib/items";
import "../styles/global.css";

const items = loadPublishedItems();
const byKind = Object.fromEntries(
  sections.map((section) => [section.kind, items.filter((item) => item.kind === section.kind)]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JC Btaiche</title>
    <meta
      name="description"
      content="JC is the Founder and CEO of Fuse, a company building pulsed-power generators for radiation effects testing and fusion energy."
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/"}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/"}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("darkMode");
          var dark =
            saved === "true" ||
            (saved === null && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="page">
      <div class="toolbar">
        <button class="toggle" type="button" id="theme-toggle" aria-label="Toggle color mode"></button>
      </div>

      <h1>JC Btaiche</h1>

      <div class="bio">
        <p>
          JC is the Founder and CEO of
          <a href="https://www.f.energy">Fuse</a>. The company’s mission is to accelerate the
          world’s transition to fusion energy while safeguarding humankind. Fuse builds
          pulsed-power generators that enable radiation effects testing today and are the
          building block for fusion energy.
        </p>
        <p>
          Fuse serves commercial and defense customers and partners with Los Alamos, Sandia
          National Laboratories, and the Nevada National Security Sites. Fuse is known for
          TITAN and FAETON, first-of-a-kind fusion generators whose experimental results were
          peer-reviewed in Nature Scientific Reports.
        </p>
        <p>JC skipped university to start Fuse. The company has raised more than $100 million.</p>
        <p>He flies small planes, climbs mountains, and makes tea.</p>
      </div>

      {
        sections.map((section) => {
          const list = byKind[section.kind] ?? [];
          if (list.length === 0) return null;
          return (
            <section>
              <h2>{section.title}</h2>
              {list.map((item) => (
                <p class="item">
                  <a href={item.url}>{item.title}</a>
                  <span class="meta">
                    {" "}
                    ({item.source}, {displayDate(item)})
                  </span>
                </p>
              ))}
            </section>
          );
        })
      }
    </main>

    <script is:inline>
      const themeBtn = document.getElementById("theme-toggle");
      if (themeBtn) {
        themeBtn.addEventListener("click", function () {
          const next = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", next);
          localStorage.setItem("darkMode", String(next));
        });
      }
    </script>
  </body>
</html>
