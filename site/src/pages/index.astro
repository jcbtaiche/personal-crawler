---
import { loadPublishedItems, sections, displayDate } from "../lib/items";
import "../styles/global.css";

const items = loadPublishedItems();
const byKind = Object.fromEntries(
  sections.map((section) => [section.kind, items.filter((item) => item.kind === section.kind)]),
);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const photoBase = `${base}photos/`;
const photos = [
  {
    file: "btaiche-headshot.jpg",
    thumb: "btaiche-headshot-thumb.jpg",
    label: "btaiche-headshot.jpg",
    dims: "1638 × 2047",
    credit: "Preferred. Credit: Fuse",
    alt: "JC Btaiche, colour portrait",
  },
  {
    file: "btaiche-facility.jpg",
    thumb: "btaiche-facility-thumb.jpg",
    label: "btaiche-facility.jpg",
    dims: "1094 × 1367",
    credit: "Credit: Fuse",
    alt: "JC Btaiche at the Fuse facility",
  },
  {
    file: "btaiche-flying.jpg",
    thumb: "btaiche-flying-thumb.jpg",
    label: "btaiche-flying.jpg",
    dims: "751 × 939",
    credit: "Personal",
    alt: "JC Btaiche flying a small plane",
  },
  {
    file: "btaiche-kilimanjaro.jpg",
    thumb: "btaiche-kilimanjaro-thumb.jpg",
    label: "btaiche-kilimanjaro.jpg",
    dims: "1320 × 1650",
    credit: "Personal",
    alt: "JC Btaiche at Uhuru Peak, Mount Kilimanjaro",
  },
  {
    file: "btaiche-lobuche.jpg",
    thumb: "btaiche-lobuche-thumb.jpg",
    label: "btaiche-lobuche.jpg",
    dims: "2400 × 3000",
    credit: "Personal",
    alt: "JC Btaiche on the summit of Lobuche East",
  },
  {
    file: "btaiche-everest.jpg",
    thumb: "btaiche-everest-thumb.jpg",
    label: "btaiche-everest.jpg",
    dims: "2400 × 3000",
    credit: "Personal",
    alt: "JC Btaiche at Everest Base Camp",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JC Btaiche</title>
    <meta
      name="description"
      content="JC is the Founder and CEO of Fuse, a company building pulsed-power generators for radiation effects testing and fusion energy."
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/"}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/"}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("darkMode");
          var dark =
            saved === "true" ||
            (saved === null && window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main class="page">
      <div class="toolbar">
        <button class="toggle" type="button" id="theme-toggle" aria-label="Toggle color mode"></button>
      </div>

      <h1>JC Btaiche</h1>

      <div class="pl-bio">
        <div class="bio">
          <p>
            JC is the Founder and CEO of
            <a href="https://www.f.energy">Fuse</a>. The company’s mission is to accelerate the
            world’s transition to fusion energy while safeguarding humankind. Fuse builds
            pulsed-power generators that enable radiation effects testing today and are the
            building block for fusion energy.
          </p>
          <p>
            Fuse serves commercial and defense customers and partners with Los Alamos, Sandia
            National Laboratories, and the Nevada National Security Sites. Fuse is known for
            TITAN and FAETON, first-of-a-kind fusion generators whose experimental results were
            peer-reviewed in Nature Scientific Reports.
          </p>
          <p>JC skipped university to build Fuse. The company has raised more than $100 million.</p>
          <p>He flies small planes, climbs mountains, and makes tea.</p>
        </div>

        <button class="pl-shot" type="button" data-pl-open aria-haspopup="dialog">
          <img src={`${photoBase}${photos[0].thumb}`} alt={photos[0].alt} />
          <span class="pl-cue">
            <span>Credit: Fuse</span>
            <b>{photos.length} photos ↗</b>
          </span>
        </button>
      </div>

      {
        sections.map((section) => {
          const list = byKind[section.kind] ?? [];
          if (list.length === 0) return null;
          return (
            <section>
              <h2>{section.title}</h2>
              {list.map((item) => (
                <p class="item">
                  <a href={item.url}>{item.title}</a>
                  <span class="meta">
                    {" "}
                    ({item.source}, {displayDate(item)})
                  </span>
                </p>
              ))}
            </section>
          );
        })
      }
    </main>

    <div class="pl-sheet" data-pl-sheet data-open="false" role="dialog" aria-modal="true" aria-label="Press photos">
      <div class="pl-sheet-top">
        <span>JC Btaiche — press photos</span>
        <button class="pl-close" type="button" data-pl-close>Close (esc)</button>
      </div>

      <div class="pl-stage" data-pl-stop>
        <img data-pl-preview src="" alt="" />
        <div class="pl-meta">
          <span data-pl-label></span>
          <span class="pl-dim" data-pl-dims></span>
          <span class="pl-dim" data-pl-credit></span>
          <a data-pl-download href="" download>Download</a>
        </div>
      </div>

      <div class="pl-sheet-bottom" data-pl-stop>
        <div class="pl-strip" data-pl-strip></div>
      </div>
    </div>

    <script is:inline>
      const themeBtn = document.getElementById("theme-toggle");
      if (themeBtn) {
        themeBtn.addEventListener("click", function () {
          const next = !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", next);
          localStorage.setItem("darkMode", String(next));
        });
      }
    </script>
    <script is:inline define:vars={{ photoBase, photos }}>
      (function () {
        var sheet = document.querySelector("[data-pl-sheet]");
        if (!sheet) return;
        var strip = sheet.querySelector("[data-pl-strip]");
        var preview = sheet.querySelector("[data-pl-preview]");
        var label = sheet.querySelector("[data-pl-label]");
        var dims = sheet.querySelector("[data-pl-dims]");
        var credit = sheet.querySelector("[data-pl-credit]");
        var dl = sheet.querySelector("[data-pl-download]");
        var closeBtn = sheet.querySelector("[data-pl-close]");
        var thumbs = [];
        var lastFocus = null;

        photos.forEach(function (p, i) {
          var b = document.createElement("button");
          b.type = "button";
          b.setAttribute("aria-label", p.label);
          b.innerHTML = '<img src="' + photoBase + p.thumb + '" alt="">';
          b.addEventListener("click", function () {
            select(i);
          });
          strip.appendChild(b);
          thumbs.push(b);
        });

        function select(i) {
          var p = photos[i];
          thumbs.forEach(function (t, n) {
            t.setAttribute("aria-current", n === i ? "true" : "false");
          });
          preview.src = photoBase + p.file;
          preview.alt = p.alt || p.label;
          label.textContent = p.label;
          dims.textContent = p.dims;
          credit.textContent = p.credit;
          dl.href = photoBase + p.file;
          dl.setAttribute("download", p.file);
        }

        function open() {
          lastFocus = document.activeElement;
          sheet.dataset.open = "true";
          document.body.style.overflow = "hidden";
          closeBtn.focus();
        }

        function close() {
          sheet.dataset.open = "false";
          document.body.style.overflow = "";
          if (lastFocus) lastFocus.focus();
        }

        document.querySelectorAll("[data-pl-open]").forEach(function (b) {
          b.addEventListener("click", open);
        });
        closeBtn.addEventListener("click", close);
        sheet.addEventListener("click", function (e) {
          if (!e.target.closest("[data-pl-stop]") && !e.target.closest("[data-pl-close]")) close();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && sheet.dataset.open === "true") close();
        });

        select(0);
      })();
    </script>
  </body>
</html>
