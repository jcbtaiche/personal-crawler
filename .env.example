# Required for email alerts (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Optional: Resend onboarding sender works until you verify a domain
NOTIFY_FROM="Personal crawler <onboarding@resend.dev>"

# Optional: YouTube Data API v3 key for video search
YOUTUBE_API_KEY=

# Optional: comma-separated Google Alerts RSS feed URLs
GOOGLE_ALERTS_RSS_URL=
